{
  "name": "hive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HIVE \u2014 swarm audio. Phones stream gyro + accelerometer to a Mac, the Mac forwards OSC to the installation.",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c blue,magenta \"vite build --watch\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "osc:listen": "tsx scripts/osc-listen.ts",
    "protocol:test": "tsx shared/protocol.test.ts",
    "docs:osc": "tsx scripts/osc-docs.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
