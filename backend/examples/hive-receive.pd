#N canvas 80 60 760 520 12;
#X text 20 10 HIVE - receive the swarm in Pure Data (vanilla >= 0.46). Protocol: docs/OSC.md;
#X text 20 30 On the Mac's dashboard add this laptop's IP with port 9000 and press Ping.;
#X obj 20 70 netreceive -u -b 9000;
#X obj 20 100 oscparse;
#X obj 20 130 list trim;
#X obj 20 160 route hive;
#X obj 20 190 route sample swarm join leave roster ping;
#X obj 20 240 unpack f s f f f f f f f f f f f f f f f f f;
#X text 20 265 slot uid t acc_x acc_y acc_z rel_x rel_y rel_z gyro_x gyro_y gyro_z activity idle acc_mag rel_mag gyro_mag turn queen;
#X floatatom 20 300 5 0 0 0 slot - -;
#X symbolatom 70 300 10 0 0 0 uid - -;
#X floatatom 160 300 8 0 0 0 rel_x - -;
#X floatatom 230 300 8 0 0 0 rel_y - -;
#X floatatom 300 300 8 0 0 0 activity - -;
#X obj 20 340 route 1 2 3 4;
#X text 90 340 <- by slot: route 1 2 3 on the same unpacked list;
#X obj 380 240 unpack f f f f f;
#X text 380 265 t count energy motion sync;
#X floatatom 380 300 6 0 0 0 count - -;
#X floatatom 430 300 8 0 0 0 energy - -;
#X floatatom 500 300 8 0 0 0 motion - -;
#X floatatom 570 300 8 0 0 0 sync - -;
